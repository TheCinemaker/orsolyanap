# ---------------------------------------------------------------------------
# SimplePay v2 - OTP Mobil Kft.
# ---------------------------------------------------------------------------
# true  -> https://sandbox.simplepay.hu/payment/v2
# false -> https://secure.simplepay.hu/payment/v2
SIMPLEPAY_SANDBOX=true

# A SimplePay kereskedoi fiokban (sandbox.simplepay.hu / admin) talalhato ertekek.
# Az alabbiak a SimplePay NYILVANOS sandbox teszt-adatai, eles uzemben cserelendok!
SIMPLEPAY_MERCHANT=PUBLICTESTHUF
SIMPLEPAY_SECRET_KEY=FxDa5w314kLlNseq2sKuVwaqZshZT5d6

# ---------------------------------------------------------------------------
# URL-ek
# ---------------------------------------------------------------------------
# A backend sajat, publikusan elerheto bazis URL-je (https kotelezo eles uzemben).
# Ebbol kepzodik a SimplePay "url" (visszairanyitas) es az IPN vegpont.
PUBLIC_BACKEND_URL=http://localhost:4000

# A React app bazis URL-je - ide dob vissza a fizetes vegen.
PUBLIC_FRONTEND_URL=http://localhost:5173

# CORS: vesszovel elvalasztott engedelyezett originek.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Uzleti szabalyok
# ---------------------------------------------------------------------------
DONATION_MIN_HUF=500
DONATION_MAX_HUF=1000000
# Meddig el a fizetesi link (perc)
PAYMENT_TIMEOUT_MINUTES=30

PORT=4000
